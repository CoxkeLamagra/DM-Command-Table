# Absolute or project-relative path to the server-local SQLite database.
DM_COMMAND_TABLE_DB_PATH=./data/dm-command-table.sqlite

# Optional development-only identity. Production continues to expect the
# authenticated user headers documented in README.md.
DM_COMMAND_TABLE_ALLOW_LOCAL_USER=false
DM_COMMAND_TABLE_LOCAL_USER_ID=local-development-user
DM_COMMAND_TABLE_LOCAL_USER_EMAIL=dm@localhost
DM_COMMAND_TABLE_LOCAL_USER_NAME=Local Dungeon Master
