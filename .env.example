# Server-local database and uploaded-image directory.
DM_COMMAND_TABLE_V6_DB_PATH=./data/dm-command-table-v6.sqlite
DM_COMMAND_TABLE_V6_UPLOAD_PATH=./data/uploads-v6

# "auto" detects HTTPS through the reverse proxy. Use true to force secure
# cookies, or false only for a trusted plain-HTTP private network.
DM_COMMAND_TABLE_SECURE_COOKIES=auto

# Required for the first administrator account in production. Generate with:
# openssl rand -base64 32
DM_COMMAND_TABLE_BOOTSTRAP_TOKEN=

# "first-user" disables public registration after initial setup. Set to "open"
# only while intentionally allowing additional people to create accounts.
DM_COMMAND_TABLE_REGISTRATION_MODE=first-user

# Per-account screenshot storage limit in MiB.
DM_COMMAND_TABLE_SCREENSHOT_QUOTA_MB=100

# Server-wide screenshot ceiling in MiB. This protects the local volume when
# several accounts upload images concurrently.
DM_COMMAND_TABLE_SCREENSHOT_GLOBAL_QUOTA_MB=1024

# Maximum undo snapshots retained per active combat encounter.
DM_COMMAND_TABLE_COMBAT_HISTORY_LIMIT=100

# Maximum audit events retained per campaign.
DM_COMMAND_TABLE_AUDIT_EVENT_LIMIT=10000
