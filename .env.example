# v12 local storage and production bootstrap configuration.
# Runtime is offline; no external catalogue or update credentials are required.
# Server-local database and uploaded-image directory.
DM_COMMAND_TABLE_DB_PATH=./data/dm-command-table.sqlite
DM_COMMAND_TABLE_UPLOAD_PATH=./data/uploads
# Consistent SQLite and screenshot backups created by `pnpm backup`.
DM_COMMAND_TABLE_BACKUP_PATH=./data/backups

# "auto" detects trusted forwarded HTTPS or a matching HTTPS browser Origin.
# Use true to force secure
# cookies, or false only for a trusted plain-HTTP private network.
DM_COMMAND_TABLE_SECURE_COOKIES=auto

# Trust X-Real-IP/X-Forwarded-For only when the application is reachable solely
# through a reverse proxy that overwrites those headers.
DM_COMMAND_TABLE_TRUST_PROXY=false

# Required for the first administrator account in production. Generate with:
# openssl rand -base64 32
DM_COMMAND_TABLE_BOOTSTRAP_TOKEN=

# The first account is administrator; registration closes automatically.
# Manage additional accounts/self-registration from Administration.

# Per-account screenshot storage limit in MiB.
DM_COMMAND_TABLE_SCREENSHOT_QUOTA_MB=100

# Server-wide screenshot ceiling in MiB. This protects the local volume when
# several accounts upload images concurrently.
DM_COMMAND_TABLE_SCREENSHOT_GLOBAL_QUOTA_MB=1024

# Maximum undo snapshots retained per active combat encounter.
DM_COMMAND_TABLE_COMBAT_HISTORY_LIMIT=100

# Maximum audit events retained per campaign.
DM_COMMAND_TABLE_AUDIT_EVENT_LIMIT=10000

# Host-managed database/account budgets (MiB and record counts).
DM_COMMAND_TABLE_DATABASE_LIMIT_MB=1024
DM_COMMAND_TABLE_MIN_FREE_SPACE_MB=128
DM_COMMAND_TABLE_CAMPAIGNS_PER_ACCOUNT=100
DM_COMMAND_TABLE_RECORDS_PER_ACCOUNT=100000
