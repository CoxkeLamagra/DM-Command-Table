{
  "name": "dm-command-table",
  "version": "7.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "backup": "node scripts/backup-local.mjs",
    "check:storage": "node scripts/check-local-storage.mjs",
    "format": "prettier --write app components db features lib server tests scripts proxy.ts next.config.ts",
    "format:check": "prettier --check app components db features lib server tests scripts proxy.ts next.config.ts",
    "verify": "pnpm audit --prod && pnpm format:check && pnpm lint && pnpm exec tsc --noEmit && pnpm test && pnpm build",
    "test:browser": "playwright test",
    "restore:check": "node scripts/restore-local.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
