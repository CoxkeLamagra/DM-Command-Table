# Optional public HTTPS edge. Replace dm.example.com and certificate paths.
# Include this file from nginx's http context, replacing the default site.
limit_req_zone $binary_remote_addr zone=dmct_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=dmct_requests:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=dmct_connections:10m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    listen [::]:80;
    server_name dm.example.com;
    return 308 https://dm.example.com$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name dm.example.com;
    ssl_certificate /etc/letsencrypt/live/dm.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dm.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($host != dm.example.com) { return 444; }

    client_max_body_size 51m;
    client_body_timeout 15s;
    client_header_timeout 10s;
    send_timeout 30s;
    keepalive_timeout 30s;
    limit_conn dmct_connections 32;
    limit_conn_status 429;
    limit_req zone=dmct_requests burst=100 nodelay;
    limit_req_status 429;
    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Both locations overwrite every trusted forwarding identity. The Node
    # listener must remain on loopback; never trust headers from public clients.
    location = /api/auth {
        limit_req zone=dmct_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering on;
        proxy_read_timeout 60s;
        proxy_connect_timeout 5s;
        proxy_hide_header X-Powered-By;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering on;
        proxy_read_timeout 60s;
        proxy_connect_timeout 5s;
        proxy_hide_header X-Powered-By;
    }
}
