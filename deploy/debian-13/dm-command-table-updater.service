[Unit]
Description=DM Command Table local update broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=dmct
WorkingDirectory=/
Environment=DM_COMMAND_TABLE_UPDATE_TARGET=latest
ExecStart=/usr/bin/node /usr/local/lib/dm-command-table/update-broker.mjs
Restart=on-failure
RestartSec=5
RuntimeDirectory=dm-command-table-updater
RuntimeDirectoryMode=0750
StateDirectory=dm-command-table-updater
StateDirectoryMode=0700
UMask=0077
MemoryMax=2G
CPUQuota=200%
TasksMax=512
KillMode=control-group
OOMPolicy=stop
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Keep this independent of dm-command-table.service so updates survive its restart.
# The updater needs systemctl, runuser and write access to releases/configuration.

[Install]
WantedBy=multi-user.target
